{
	"name": "kassaklap",
	"version": "0.1.0",
	"description": "A monorepo template built with Hono, Vite, and React",
	"author": "Vinicius Cainelli",
	"packageManager": "pnpm@8.15.4",
	"workspaces": [
		"./server",
		"./client",
		"./shared"
	],
	"scripts": {
		"dev": "turbo dev",
		"dev:client": "turbo dev --filter=client",
		"dev:server": "pnpm --filter server dev",
		"build": "turbo build",
		"build:client": "turbo build --filter=client",
		"build:server": "turbo build --filter=server",
		"lint": "biome lint .",
		"lint:fix": "biome lint . --write",
		"type-check": "turbo type-check",
		"test": "vitest",
		"dev:test": "vitest --watch",
		"postinstall": "turbo build --filter=shared --filter=server",
		"format": "biome format . --write",
		"deploy": "turbo build && wrangler deploy --minify"
	},
	"keywords": [
		"hono",
		"react",
		"vite",
		"monorepo",
		"turbo"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.2.4",
		"@cloudflare/workers-types": "^4.20250913.0",
		"turbo": "^2.5.6",
		"wrangler": "^4.36.0",
		"vitest": "^3.2.4",
		"@vitest/ui": "^3.2.4"
	},
	"peerDependencies": {
		"typescript": "^5.7.3"
	},
	"dependencies": {
		"hono": "^4.9.7"
	}
}
